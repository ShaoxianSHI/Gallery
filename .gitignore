# Nuitka 编译失败时写在当前目录的崩溃报告
nuitka-crash-report.xml

# ---- Gallery 运行时数据 ----
# .gallery/ 里除 config.toml 外的内容都是可重建的缓存与日志
.gallery/*
!.gallery/config.toml

# ---- 本地测试数据 ----
# 仓库里不放用户的照片，也不放任何大尺寸二进制
/测试相册/
/IMG_*.jpg
/IMG_*.jpeg
/IMG_*.JPG
/DSC_*.jpg
/DSC_*.JPG

# ---- 本机笔记 ----
# docs/adr/ 是对外公开的设计决策记录，随仓库分发；其余几个文件是本机调研记录
/docs/*
!/docs/adr/
AGENTS.md

